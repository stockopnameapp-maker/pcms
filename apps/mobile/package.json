{
  "name": "@pcms/mobile",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Palmora Health mobile app for clinic doctors and nurses (Android, Capacitor)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
