NODE_ENV=development
PORT=8080
# Runtime connection — MUST be the RLS-restricted role
DATABASE_URL=postgres://pcms_app:change-me-app@localhost:5432/pcms
# Owner connection — ONLY for scheduled jobs (alert engine, partition upkeep)
DATABASE_OWNER_URL=postgres://pcms_owner:change-me-owner@localhost:5432/pcms
# openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
# openssl rand -base64 32  (AES-256-GCM key for field-level encryption)
FIELD_ENCRYPTION_KEY=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7
SESSION_IDLE_MINUTES=30
CORS_ORIGINS=http://localhost:5173
STORAGE_DIR=./storage
JOBS_ENABLED=true
ALERT_ENGINE_INTERVAL_MINUTES=15
