# Superuser / cloud admin — only for bootstrap (create roles + database)
# macOS (Homebrew / Postgres.app): the superuser is your macOS username, no password, e.g.
#   PG_ADMIN_URL=postgres://faisalnugraha@localhost:5432/postgres
# Linux / Docker: usually postgres://postgres:<password>@localhost:5432/postgres
PG_ADMIN_URL=postgres://postgres@localhost:5432/postgres
PCMS_DB_NAME=pcms
PCMS_OWNER_PASSWORD=change-me-owner
PCMS_APP_PASSWORD=change-me-app
# Migration / seed connection (owner role)
DATABASE_OWNER_URL=postgres://pcms_owner:change-me-owner@localhost:5432/pcms
# Runtime connection used by the API and the security tests (RLS enforced)
DATABASE_URL=postgres://pcms_app:change-me-app@localhost:5432/pcms
